{
  "name": "flowcapture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "setup": "node scripts/setup-dev.mjs",
    "setup:install": "node scripts/setup-dev.mjs --install",
    "tauri": "tauri",
    "tauri:dev": "node scripts/setup-dev.mjs --check-only && tauri dev",
    "tauri:build": "npm run tauri build",
    "test:rust": "cd src-tauri && cargo test",
    "build:linux": "bash scripts/docker-linux-build.sh",
    "build:linux:bundle": "bash scripts/docker-linux-build.sh --bundle",
    "website:dev": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "website:preview": "npm run preview --prefix website"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  }
}
